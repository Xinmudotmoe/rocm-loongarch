pkgbase='rocm-llvm'
pkgname=('rocm-llvm')
pkgver=7.0.2
pkgrel=702000
pkgdesc="rocm-core is a utility which can be used to get ROCm release version."
arch=('loong64' 'x86_64' 'riscv64' 'mips64el')
license=('Apache')
url="https://github.com/ROCm/llvm-project"
provides=('rocm-compilersupport' 'rocm-device-libs')
source=(
    "git+https://github.com/ROCm/llvm-project.git#tag=rocm-$pkgver"
    0001-llvm-loongarch64-change-default-code-model.patch
    0002-rocm-llvm-loongarch64-feature-support.patch
    0003-llvm-linker-extra.patch
)
b2sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')
prepare() {
  cd llvm-project
    git apply ../*.patch
  cd ..
  EXT_CFLAGS="-pipe -fPIC"
# if use clang19 build
# add -Wno-missing-template-arg-list-after-template-kw
# if CMAKE_C_COMPILER!=clang
#   do not enable flang
  if [ $CARCH == 'loong64' ];
  then
    EXT_CFLAGS="-mcmodel=medium $EXT_CFLAGS"
  fi
  cat  > toolchain.cmake << EOF
set(CMAKE_BUILD_TYPE "Release")
set(CMAKE_INSTALL_PREFIX "/opt/rocm-${pkgver}/lib/llvm")
set(CMAKE_INSTALL_RPATH "/opt/rocm-${pkgver}/lib/llvm/lib;/opt/rocm-${pkgver}/lib;/opt/rocm-${pkgver}/lib64")
set(CMAKE_C_FLAGS "$EXT_CFLAGS")
set(CMAKE_CXX_FLAGS "$EXT_CFLAGS")
set(CMAKE_C_COMPILER "clang")
set(CMAKE_CXX_COMPILER "clang++")
set(CMAKE_LINKER_TYPE "LLD")
EOF
  mkdir build || true
  cd build
  cmake \
  -DCMAKE_TOOLCHAIN_FILE=$PWD/../toolchain.cmake \
  -DBUILD_SHARED_LIBS=ON \
  -DLLVM_ENABLE_LIBCXX=OFF \
  -DLIBCXX_ENABLE_SHARED=OFF \
  -DLIBCXX_ENABLE_STATIC=ON \
  -DLIBCXXABI_ENABLE_SHARED=OFF \
  -DLIBCXXABI_ENABLE_STATIC=ON \
  -DLIBCXX_ENABLE_STATIC_ABI_LIBRARY=ON \
  -DLIBCXXABI_USE_LLVM_UNWINDER=ON \
  -DLIBCXX_USE_COMPILER_RT=ON \
  -DLLVM_ENABLE_PIC=ON \
  -DLLVM_ENABLE_ASSERTIONS=OFF \
  -DLLVM_TARGETS_TO_BUILD='host;AMDGPU' \
  -DLLVM_EXPERIMENTAL_TARGETS_TO_BUILD="SPIRV" \
  -DLLVM_ENABLE_PROJECTS='clang;lld;flang' \
  -DLLVM_ENABLE_RUNTIMES='libcxx;libcxxabi;libunwind;compiler-rt' \
  -DRUNTIMES_CMAKE_ARGS='-DCMAKE_LINKER_TYPE=LLD;-DCOMPILER_RT_INCLUDE_TESTS=OFF;-DCOMPILER_RT_BUILD_SANITIZERS=OFF;-DCOMPILER_RT_BUILD_XRAY=OFF;-DCOMPILER_RT_BUILD_MEMPROF=OFF;-DCOMPILER_RT_BUILD_CTX_PROFILE=OFF' \
  -DLLVM_INCLUDE_TESTS=OFF \
  -G "Ninja" \
  -DCMAKE_SKIP_RPATH=OFF \
  -S ../llvm-project/llvm/
}
build() {
  cd build
  cmake --build .
}

check() {
#  cd build
#  ninja check
echo
}

#packaging() {

#}
package() {
  cd build
  cmake --install . --prefix "$pkgdir"/opt/rocm-${pkgver}/lib/llvm
  ln -s ./lib/llvm "$pkgdir"/opt/rocm-${pkgver}/llvm
  mkdir "$pkgdir"/opt/rocm-${pkgver}/bin/
  ln -s ../lib/llvm/bin/amdclang++ "$pkgdir"/opt/rocm-${pkgver}/bin/amdclang++
  ln -s ../lib/llvm/bin/amdclang "$pkgdir"/opt/rocm-${pkgver}/bin/amdclang
  ln -s ../lib/llvm/bin/clang++ "$pkgdir"/opt/rocm-${pkgver}/bin/clang++
  ln -s ../lib/llvm/bin/clang "$pkgdir"/opt/rocm-${pkgver}/bin/clang
  ln -s ../lib/llvm/bin/llc "$pkgdir"/opt/rocm-${pkgver}/bin/llc

}
